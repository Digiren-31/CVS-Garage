# Backend HTTP port used by `npm start`.
PORT=4000

# Optional absolute or repository-relative directory for local JSON state.
# CVS_DATA_DIR=backend/data

# Set true only after the hosted Supabase project has been migrated.
SUPABASE_ENABLED=false

# Public Supabase project settings. The publishable key is safe for browser use
# because authorization is enforced by RLS and the Express backend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only values. Keep these in .env.local and the Render secret manager.
# Never prefix either value with VITE_ and never commit real values.
SUPABASE_SECRET_KEY=sb_secret_replace_me
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Used only by Supabase CLI migration commands. Keep local and unset on Render.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=replace_me

# Render terminates TLS before forwarding traffic to Express.
TRUST_PROXY=1
