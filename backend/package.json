{
  "name": "@cvs-garage/backend",
  "version": "1.0.0",
  "description": "Central modular backend for the CVS Garage college innovation portal",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node scripts/validate-build.js",
    "test": "cross-env NODE_ENV=test node --test tests/*.test.js",
